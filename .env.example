# Local development only. Copy to .env; never commit .env.
#
# The new application has no hosted database. DATABASE_URL must point at the
# local Compose database below: drizzle.config.ts refuses any other host.
# Never reuse a connection string from the archived application's hosting.

POSTGRES_USER=refrain_mixtapes
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=refrain_mixtapes
POSTGRES_PORT=5442

DATABASE_URL=postgres://refrain_mixtapes:change-me-local-only@127.0.0.1:5442/refrain_mixtapes
