# Local development only. Copy to .env; never commit .env.
#
# The new application has no hosted database. DATABASE_URL must point at the
# local Compose database below: drizzle.config.ts refuses any other host.
# Never reuse a connection string from the archived application's hosting.

POSTGRES_USER=refrain_mixtapes
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=refrain_mixtapes
POSTGRES_PORT=5442

DATABASE_URL=postgres://refrain_mixtapes:change-me-local-only@127.0.0.1:5442/refrain_mixtapes

# Studio sign-in (decision 0002). The owner's email, and the hash printed by
# `pnpm studio:hash` (never the password itself). Without both, sign-in is
# closed. Set them per environment on the host; never commit real values.
STUDIO_EMAIL=
STUDIO_PASSWORD_HASH=

# Photograph storage. In production: a Vercel Blob read-write token. Unset in
# local development: uploads are written to .media/ and served from /media/.
BLOB_READ_WRITE_TOKEN=
