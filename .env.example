# Local development configuration. Copy this file to .env, which Git ignores:
#
#   cp .env.example .env
#
# Docker Compose, Next.js, Drizzle Kit, and the integration tests all read .env.
# These values are placeholders for a local, disposable database. They are not
# secrets. Real or production credentials never belong in this file.

# PostgreSQL container (read by Docker Compose)
POSTGRES_USER=refrain
POSTGRES_PASSWORD=refrain-local-only
POSTGRES_DB=refrain
POSTGRES_PORT=5432

# Server-side connection string. It must match the values above.
# Never expose it to the browser: do not add a NEXT_PUBLIC_ prefix.
DATABASE_URL=postgres://refrain:refrain-local-only@127.0.0.1:5432/refrain

# Disposable integration-test database (`pnpm db:test:up`). A separate server
# with fixed local credentials (compose.yaml) whose data is discarded when it
# stops. Integration tests use only this URL, never DATABASE_URL.
POSTGRES_TEST_PORT=5433
TEST_DATABASE_URL=postgres://refrain_test:refrain-test-local-only@127.0.0.1:5433/refrain_test

# Authentication (docs/development.md § Authentication). Server-side only:
# never add a NEXT_PUBLIC_ prefix. Authentication refuses to start while any
# of these is missing or unsafe; there are no defaults.
#
# Signs session cookies. Generate a new one for every environment, and keep
# it out of the repository:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
# The application's origin. HTTPS is required unless it is localhost.
BETTER_AUTH_URL=http://localhost:3000
# The single author's email address. Only this account can use the studio.
# The account itself is created with `pnpm author:provision`.
REFRAIN_AUTHOR_EMAIL=author@example.com

# Public reads (docs/security.md § Public page release gates). Server-side only.
# Off unless this is exactly `true`: unset, empty, TRUE, 1, yes, and every other
# value leave all public addresses answering the unknown-address 404. Never
# switch it on in a deployment that anyone else can reach until the release
# gates are closed. It is deliberately not set here.
# REFRAIN_PUBLIC_READS_ENABLED=true
