# Local development configuration. Copy this file to .env, which Git ignores:
#
#   cp .env.example .env
#
# Docker Compose, Next.js, Drizzle Kit, and the integration tests all read .env.
# These values are placeholders for a local, disposable database. They are not
# secrets. Real or production credentials never belong in this file.

# PostgreSQL container (read by Docker Compose)
POSTGRES_USER=refrain
POSTGRES_PASSWORD=refrain-local-only
POSTGRES_DB=refrain
POSTGRES_PORT=5432

# Server-side connection string. It must match the values above.
# Never expose it to the browser: do not add a NEXT_PUBLIC_ prefix.
DATABASE_URL=postgres://refrain:refrain-local-only@127.0.0.1:5432/refrain
