{
  "name": "refrain",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "^24.22.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:http": "vitest run --project http",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:run": "playwright test",
    "review:screens": "pnpm build && VISUAL_REVIEW=1 playwright test --project=visual-review",
    "db:up": "docker compose up --detach --wait postgres",
    "db:down": "docker compose down",
    "db:test:up": "docker compose --profile test up --detach --wait postgres-test",
    "db:test:down": "docker compose --profile test rm --stop --force postgres-test",
    "design:strokes": "tsx src/design/write-strokes.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:backup": "tsx src/ops/cli-entry.ts backup",
    "db:backup:verify": "tsx src/ops/cli-entry.ts verify",
    "author:provision": "tsx --conditions=react-server src/modules/identity/cli-entry.ts provision",
    "author:reset-password": "tsx --conditions=react-server src/modules/identity/cli-entry.ts reset-password"
  },
  "dependencies": {
    "better-auth": "1.7.12",
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "roughjs": "4.6.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
